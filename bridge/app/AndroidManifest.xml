<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.ir2.companion"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <!-- the bridge service runs as this app's uid: INTERNET puts it in the inet group so it can listen -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- this head unit checks GET_TASKS even in Activity.finish() (HMG-API's notes) -->
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">
        <activity
            android:name=".PairActivity"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
